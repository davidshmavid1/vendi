# Copy to backend/.env for local development (backend/.env is git-ignored).
# Placeholders only — never commit real credentials.

# The Django backend's own database on your local PostgreSQL (port 5432).
# Must NOT be the Next.js/Prisma DATABASE_URL.
BACKEND_DATABASE_URL=postgres://vendi:change-me-local-only@localhost:5432/vendi_backend_dev

# Only if you use the optional Docker setup (compose.yaml): these create the
# container's database, and it listens on port 5433, so change the URL above
# to ...@localhost:5433/vendi_backend_dev.
POSTGRES_USER=vendi
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=vendi_backend_dev

# Optional in development (an insecure dev-only default is used if unset).
# Required in production: generate with
#   uv run python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
# DJANGO_SECRET_KEY=

# Optional in development (defaults to localhost,127.0.0.1). Required in production.
# DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Origin of the Next.js app. Account emails link here, and it is trusted for CSRF.
# Development defaults: http://localhost:3000 for both.
# FRONTEND_BASE_URL=http://localhost:3000
# DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:3000

# Production only (see backend/README.md → Production settings):
# DJANGO_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# DEFAULT_FROM_EMAIL=Vendi <no-reply@example.com>
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# TRUSTED_PROXY_COUNT=1
# TRUST_PROXY_SSL_HEADER=false
# SECURE_SSL_REDIRECT=true
# SECURE_HSTS_SECONDS=3600
# API_DOCS_ENABLED=false

# Stripe TEST-mode keys for stall payments (optional; without them checkout
# reports that payments are unavailable). Live keys are ignored unless
# STRIPE_ALLOW_LIVE=true is set in production. See README → Payments.
# Prefer a restricted key from a sandbox (see README → Payments).
# STRIPE_SECRET_KEY=rk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
