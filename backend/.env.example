# Copy to backend/.env for local development (backend/.env is git-ignored).
# Placeholders only — never commit real credentials.

# Used by compose.yaml to create the local PostgreSQL container.
POSTGRES_USER=vendi
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=vendi_backend_dev

# The Django backend's own database. Must NOT be the Next.js/Prisma DATABASE_URL.
# compose.yaml publishes PostgreSQL on port 5433 to avoid clashing with 5432.
BACKEND_DATABASE_URL=postgres://vendi:change-me-local-only@localhost:5433/vendi_backend_dev

# Optional in development (an insecure dev-only default is used if unset).
# Required in production: generate with
#   uv run python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
# DJANGO_SECRET_KEY=

# Optional in development (defaults to localhost,127.0.0.1). Required in production.
# DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Production only (see backend/README.md → Production settings):
# DJANGO_CSRF_TRUSTED_ORIGINS=https://api.example.com
# TRUST_PROXY_SSL_HEADER=false
# SECURE_SSL_REDIRECT=true
# SECURE_HSTS_SECONDS=3600
# API_DOCS_ENABLED=false
